APP_NAME="Wedding Planner"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://planner.example.test
APP_KEY=base64:replace-with-generated-key
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
DB_CONNECTION=pgsql
DB_HOST=database.internal
DB_PORT=5432
DB_DATABASE=wedding_planner
DB_USERNAME=replace-with-runtime-user
DB_PASSWORD=replace-with-runtime-secret
FILESYSTEM_DISK=local
ATTACHMENT_DISK=supabase
SUPABASE_URL=https://project.supabase.co
SUPABASE_STORAGE_BUCKET=wedding-planner-private
SUPABASE_STORAGE_REGION=ap-southeast-1
SUPABASE_STORAGE_KEY=server-only-runtime-secret
SUPABASE_STORAGE_SECRET=server-only-runtime-secret
LOG_CHANNEL=stderr
LOG_LEVEL=warning
